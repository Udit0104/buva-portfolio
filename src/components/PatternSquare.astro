---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<div class:list={["pointer-events-none", className]}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="100%"
    height="100%"
    viewBox="0 0 100 100"
    preserveAspectRatio="xMidYMid slice"
  >
    <defs>
      <pattern id="squares" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
        <rect x="0" y="0" width="19" height="19" fill="none" stroke="currentColor" stroke-width="0.5" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#squares)" />
  </svg>
</div>
